rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Funciones auxiliares
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserUid() {
      return request.auth.uid;
    }

    // Verifica si el usuario es el propietario (ownerId) del sitio
    function isSiteOwner(siteId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/sites/$(siteId))
        && get(/databases/$(database)/documents/sites/$(siteId)).data.ownerId == getUserUid();
    }

    // Obtiene el rol de un usuario dentro de un sitio específico.
    // Busca primero en el campo roles del documento del sitio (legacy),
    // y luego en la subcolección members/{uid}.
    function getSiteRole(siteId) {
      return (
        // Intentar obtener el rol legacy del campo roles del sitio
        (get(/databases/$(database)/documents/sites/$(siteId)).data.roles[getUserUid()] != null
          ? get(/databases/$(database)/documents/sites/$(siteId)).data.roles[getUserUid()]
          // Si no hay legacy, buscar en la subcolección members
          : (get(/databases/$(database)/documents/sites/$(siteId)/members/$(getUserUid())).exists
            ? get(/databases/$(database)/documents/sites/$(siteId)/members/$(getUserUid())).data.role
            : null
          )
        )
      );
    }

    // Verifica si el usuario tiene un rol específico (o superior) en el sitio
    function hasRole(siteId, requiredRole) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/sites/$(siteId))
        && getSiteRole(siteId) in ['admin', 'editor', 'user']
        && (
          (requiredRole == 'user') ||
          (requiredRole == 'editor' && getSiteRole(siteId) in ['editor', 'admin']) ||
          (requiredRole == 'admin' && getSiteRole(siteId) == 'admin')
        );
    }

    // Verifica si el usuario es admin global (superadmin)
    function isGlobalAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admin/users/$(getUserUid()))
        && get(/databases/$(database)/documents/admin/users/$(getUserUid())).data.role == 'superadmin';
    }

    // ============================================================
    // Colección: sites/{domain}
    // Cada sitio es un documento cuyo ID es el dominio
    // ============================================================
    match /sites/{domain} {

      // --- Lectura ---
      // Público: puede leer sitios activos (sin autenticación)
      // Propietario, miembros del sitio o admin global: pueden leer siempre
      allow read: if resource.data.status == 'active';
      allow read: if isAuthenticated() && (
        isSiteOwner(domain)
        || hasRole(domain, 'user')
        || isGlobalAdmin()
      );

      // --- Creación ---
      // Solo autenticado, y el ownerId debe ser el propio usuario
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == getUserUid()
        && request.resource.data.roles[getUserUid()] == 'admin'
        && request.resource.data.status in ['active', 'pending'];

      // --- Actualización ---
      // Propietario (ownerId), admin del sitio, o admin global
      allow update: if isSiteOwner(domain) || hasRole(domain, 'admin') || isGlobalAdmin();

      // --- Eliminación ---
      // Solo admin global
      allow delete: if isGlobalAdmin();

      // ============================================================
      // Subcolección: sites/{domain}/settings
      // Configuración del sitio (nombre, descripción, SEO, etc.)
      // ============================================================
      match /settings/{settingId} {
        allow read: if true;
        allow write: if isSiteOwner(domain) || hasRole(domain, 'admin') || isGlobalAdmin();
      }

      // ============================================================
      // Subcolección: sites/{domain}/pages
      // Páginas personalizadas creadas por el editor de bloques
      // ============================================================
      match /pages/{pageId} {

        // Lectura pública de páginas publicadas;
        // Propietario, editores y miembros pueden leer todas (incluyendo borradores)
        allow read: if resource.data.published == true
          || (isAuthenticated() && (
            isSiteOwner(domain)
            || hasRole(domain, 'user')
            || isGlobalAdmin()
          ));

        // Creación y edición: Propietario, editor o admin del sitio
        allow create, update: if isAuthenticated() && (
          isSiteOwner(domain)
          || hasRole(domain, 'editor')
          || isGlobalAdmin()
        );

        // Eliminación: Propietario o admin del sitio
        allow delete: if isAuthenticated() && (
          isSiteOwner(domain)
          || hasRole(domain, 'admin')
          || isGlobalAdmin()
        );
      }

      // ============================================================
      // Subcolección: sites/{domain}/posts
      // Contenido del sitio (blog posts, etc.)
      // ============================================================
      match /posts/{postId} {

        allow read: if resource.data.published == true
          || (isAuthenticated() && (
            isSiteOwner(domain)
            || hasRole(domain, 'user')
            || isGlobalAdmin()
          ));

        // Creación: propietario o cualquier miembro del sitio
        allow create: if isSiteOwner(domain) || hasRole(domain, 'user');

        // Actualización: propietario, editor, o el propio autor
        allow update: if isSiteOwner(domain)
          || hasRole(domain, 'editor')
          || (hasRole(domain, 'user') && resource.data.authorId == getUserUid())
          || isGlobalAdmin();

        // Eliminación: propietario, admin del sitio, o admin global
        allow delete: if isSiteOwner(domain) || hasRole(domain, 'admin') || isGlobalAdmin();
      }

      // ============================================================
      // Subcolección: sites/{domain}/members
      // Miembros del sitio con sus roles
      // ============================================================
      match /members/{userId} {
        allow read: if isSiteOwner(domain) || hasRole(domain, 'user');
        allow write: if isSiteOwner(domain) || hasRole(domain, 'admin');
      }
    }

    // ============================================================
    // Colección: admin (solo accesible para superadmins)
    // ============================================================
    match /admin/{document=**} {
      allow read, write: if isGlobalAdmin();
    }

    // ============================================================
    // Colección: users (perfiles públicos de usuarios)
    // ============================================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == getUserUid();
      allow update: if isAuthenticated() && resource.data.uid == getUserUid();
      allow delete: if isGlobalAdmin();
    }

    // ============================================================
    // Colección: media (archivos públicos)
    // ============================================================
    match /media/{mediaId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow delete: if isGlobalAdmin();
    }

    // ============================================================
    // Denegar todo lo demás por defecto
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

