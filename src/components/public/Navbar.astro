---
// ============================================
// Navbar - Barra de navegación dinámica
// ============================================
//
// Renderiza el navbar solo si hay enlaces.
// Usa variables CSS del tema: --navbar-bg, --navbar-text, --accent
// Props: siteName, navLinks
// ============================================

export interface Props {
    siteName: string;
    navLinks?: Array<{ label: string; href: string }>;
}

const { siteName, navLinks } = Astro.props;
const displayName = siteName || "Mi Web Personalizable";
---

{
    navLinks && navLinks.length > 0 && (
        <header class="navbar">
            <div class="container navbar-inner">
                <a href="/" class="navbar-brand">
                    {displayName}
                </a>
                <nav class="navbar-links">
                    {navLinks.map((link) => (
                        <a href={link.href} class="navbar-link">
                            {link.label}
                        </a>
                    ))}
                </nav>
            </div>
        </header>
    )
}

<style>
    .navbar {
        background: var(--navbar-bg, #ffffff);
        border-bottom: 1px solid var(--navbar-border, #e5e7eb);
        position: sticky;
        top: 0;
        z-index: 100;
    }
    .navbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 4rem;
    }
    .navbar-brand {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--navbar-text, #1a1a2e);
    }
    .navbar-brand:hover {
        text-decoration: none;
        color: var(--accent, #4f46e5);
    }
    .navbar-links {
        display: flex;
        gap: 1.5rem;
    }
    .navbar-link {
        font-size: 0.9375rem;
        color: var(--navbar-text, #4b5563);
        opacity: var(--navbar-link-opacity, 0.8);
        transition: color 0.2s, opacity 0.2s;
    }
    .navbar-link:hover {
        color: var(--accent, #4f46e5);
        opacity: 1;
        text-decoration: none;
    }

    @media (max-width: 768px) {
        .navbar-inner {
            flex-direction: column;
            height: auto;
            padding: 1rem 0;
            gap: 0.75rem;
        }
    }
</style>
