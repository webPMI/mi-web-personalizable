---
// ============================================
// PublicLayout - Layout público 100% dinámico
// ============================================
//
// Orquestador que importa y monta los
// subcomponentes del sitio público.
// Define todas las variables CSS del tema.
//
// Uso:
//   <PublicLayout site={siteData} />
// ============================================

import type { SiteData } from "../../lib/site";
import Navbar from "./Navbar.astro";
import HeroSection from "./HeroSection.astro";
import DynamicSections from "./DynamicSections.astro";
import SocialLinks from "./SocialLinks.astro";
import Footer from "./Footer.astro";
import { generateThemeCssBlock } from "../../lib/theme";

export interface Props {
    site: SiteData;
}

const { site } = Astro.props;

const displayName = site.siteName || "Mi Web Personalizable";
const themeCss = generateThemeCssBlock(site.theme);
---

<!DOCTYPE html>
<html lang={site.locale || "es"}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{site.seo?.defaultTitle || displayName}</title>
    {site.seo?.defaultDescription && (
        <meta name="description" content={site.seo.defaultDescription} />
    )}
    {site.seo?.defaultImage && (
        <>
            <meta property="og:image" content={site.seo.defaultImage} />
            <meta name="twitter:card" content="summary_large_image" />
        </>
    )}
    <style set:html={themeCss}></style>
    <style>
        /* ============================================
           Reset y estilos base
           ============================================ */
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: var(--font-family);
            font-size: var(--font-size-base);
            font-weight: var(--font-weight);
            color: var(--text);
            background: var(--bg);
            line-height: var(--line-height, 1.6);
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-headings);
            line-height: var(--heading-line-height, 1.3);
        }

        h1 { font-size: var(--h1-size, 2.5rem); }
        h2 { font-size: var(--h2-size, 2rem); }
        h3 { font-size: var(--h3-size, 1.25rem); }

        a {
            color: var(--accent);
            text-decoration: none;
        }
        a:hover { text-decoration: var(--link-hover-decoration, underline); }

        img { max-width: 100%; height: auto; }

        .container {
            max-width: var(--max-width);
            margin: 0 auto;
            padding: 0 var(--container-padding);
        }

        section {
            padding: var(--section-gap) 0;
        }

        /* ============================================
           Botón genérico del sitio
           ============================================ */
        .btn-site {
            display: inline-block;
            padding: var(--btn-py) var(--btn-px);
            border-radius: var(--btn-radius);
            font-family: inherit;
            font-size: inherit;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            line-height: 1.4;
        }

        .btn-site--filled {
            background: var(--accent);
            color: var(--btn-text-color, #ffffff);
            border: none;
        }
        .btn-site--filled:hover {
            opacity: 0.9;
            text-decoration: none;
        }

        .btn-site--outline {
            background: transparent;
            color: var(--accent);
            border: 2px solid var(--accent);
        }
        .btn-site--outline:hover {
            background: var(--accent);
            color: var(--btn-text-color, #ffffff);
            text-decoration: none;
        }

        .btn-site--ghost {
            background: transparent;
            color: var(--accent);
            border: none;
        }
        .btn-site--ghost:hover {
            background: var(--btn-hover-bg, rgba(79, 70, 229, 0.08));
            text-decoration: none;
        }
    </style>
</head>
<body>
    <Navbar
        siteName={site.siteName}
        navLinks={site.navLinks}
    />

    <main>
        <HeroSection
            heroTitle={site.heroTitle}
            heroSubtitle={site.heroSubtitle}
            heroImage={site.heroImage}
            heroCtaText={site.heroCtaText}
            heroCtaLink={site.heroCtaLink}
        />

        <DynamicSections sections={site.sections} />

        <SocialLinks socialLinks={site.socialLinks} />
    </main>

    <Footer
        siteName={site.siteName}
        navLinks={site.navLinks}
    />
</body>
</html>
