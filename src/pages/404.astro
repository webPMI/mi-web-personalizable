---
import Layout from "../layouts/Layout.astro";
import DevTools from "../components/devtools/DevTools.astro";
---

<Layout title="404 - Página no encontrada">
  <DevTools />
  <div class="not-found-page">
    <div class="not-found-bg">
      <div class="not-found-shape shape-1"></div>
      <div class="not-found-shape shape-2"></div>
      <div class="not-found-shape shape-3"></div>
    </div>

    <div class="not-found-card">
      <div class="not-found-code">
        <span class="digit">4</span>
        <span class="digit zero">0</span>
        <span class="digit">4</span>
      </div>

      <div class="not-found-icon">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>

      <h1 class="not-found-title" id="not-found-title">Página no encontrada</h1>
      <p class="not-found-description" id="not-found-description">
        La página que buscas no existe o ha sido movida.
      </p>
      <p class="not-found-suggestion" id="not-found-suggestion">
        Puede que la dirección esté mal escrita o que la página haya sido eliminada.
      </p>

      <div class="not-found-actions">
        <a href="/" class="btn btn-primary" id="not-found-cta-home">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          Volver al inicio
        </a>
        <a href="/login" class="btn btn-secondary" id="not-found-cta-login">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
            <polyline points="10 17 15 12 10 7"/>
            <line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
          Iniciar sesión
        </a>
      </div>

      <div class="not-found-footer">
        <span class="not-found-error-code" id="not-found-error-code">Error 404</span>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { t, getStoredLocale, setStoredLocale, type SupportedLocale } from "../lib/i18n";

  const elements = {
    title: document.getElementById("not-found-title"),
    description: document.getElementById("not-found-description"),
    suggestion: document.getElementById("not-found-suggestion"),
    ctaHome: document.getElementById("not-found-cta-home"),
    ctaLogin: document.getElementById("not-found-cta-login"),
    errorCode: document.getElementById("not-found-error-code"),
  };

  function applyLocale(locale: SupportedLocale) {
    if (elements.title) elements.title.textContent = t("public:404-title");
    if (elements.description) elements.description.textContent = t("public:404-description");
    if (elements.suggestion) elements.suggestion.textContent = t("public:404-suggestion");
    if (elements.errorCode) elements.errorCode.textContent = t("public:404-error-code");

    // Los botones tienen iconos SVG, mantener el texto pero preservar el SVG
    if (elements.ctaHome) {
      const svg = elements.ctaHome.querySelector("svg");
      elements.ctaHome.innerHTML = (svg ? svg.outerHTML : "") + t("public:404-cta-home");
    }
    if (elements.ctaLogin) {
      const svg = elements.ctaLogin.querySelector("svg");
      elements.ctaLogin.innerHTML = (svg ? svg.outerHTML : "") + t("public:404-cta-login");
    }
  }

  // Aplicar idioma guardado
  const currentLocale = getStoredLocale();
  applyLocale(currentLocale);

  // Selector de idioma flotante
  const localeToggle = document.createElement("button");
  localeToggle.className = "locale-toggle";
  localeToggle.textContent = currentLocale === "es" ? "EN" : "ES";
  localeToggle.title = currentLocale === "es" ? "Switch to English" : "Cambiar a español";
  localeToggle.addEventListener("click", () => {
    const newLocale: SupportedLocale = getStoredLocale() === "es" ? "en" : "es";
    setStoredLocale(newLocale);
    localeToggle.textContent = newLocale === "es" ? "EN" : "ES";
    localeToggle.title = newLocale === "es" ? "Switch to English" : "Cambiar a español";
    applyLocale(newLocale);
  });
  document.body.appendChild(localeToggle);
</script>

<style>
  /* ============================================
     404 Page - Estilos
     ============================================ */

  .not-found-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  /* --- Background shapes --- */
  .not-found-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .not-found-shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0.08;
  }

  .shape-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #6366f1, transparent);
    top: -200px;
    right: -200px;
    animation: float 20s ease-in-out infinite;
  }

  .shape-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #8b5cf6, transparent);
    bottom: -100px;
    left: -100px;
    animation: float 25s ease-in-out infinite reverse;
  }

  .shape-3 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, #3b82f6, transparent);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: float 30s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -30px) scale(1.05); }
    66% { transform: translate(-20px, 20px) scale(0.95); }
  }

  /* --- Card --- */
  .not-found-card {
    position: relative;
    text-align: center;
    max-width: 520px;
    width: 100%;
    z-index: 1;
  }

  /* --- 404 Number --- */
  .not-found-code {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    perspective: 800px;
  }

  .digit {
    font-size: 8rem;
    font-weight: 900;
    line-height: 1;
    background: linear-gradient(135deg, #6366f1, #8b5cf6, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.05em;
    display: inline-block;
    animation: bounceDigit 3s ease-in-out infinite;
  }

  .digit.zero {
    animation-delay: 0.15s;
    background: linear-gradient(135deg, #3b82f6, #6366f1, #8b5cf6);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .digit:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes bounceDigit {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-8px) scale(1.02); }
  }

  /* --- Icon --- */
  .not-found-icon {
    color: #64748b;
    margin-bottom: 1.5rem;
    opacity: 0.6;
  }

  /* --- Text --- */
  .not-found-title {
    font-size: 2rem;
    font-weight: 700;
    color: #f1f5f9;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .not-found-description {
    font-size: 1.125rem;
    color: #94a3b8;
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .not-found-suggestion {
    font-size: 0.9375rem;
    color: #64748b;
    margin-bottom: 2.5rem;
    line-height: 1.5;
  }

  /* --- Buttons --- */
  .not-found-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    border: none;
  }

  .btn svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .btn-primary {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(4px);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-1px);
  }

  .btn-secondary:active {
    transform: translateY(0);
  }

  /* --- Footer --- */
  .not-found-footer {
    margin-top: 3rem;
  }

  .not-found-error-code {
    font-size: 0.8125rem;
    color: #475569;
    font-family: "SF Mono", "Fira Code", "Fira Mono", monospace;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.375rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
  }

  /* --- Locale toggle --- */
  .locale-toggle {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 9999;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    backdrop-filter: blur(4px);
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .locale-toggle:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.2);
    transform: scale(1.05);
  }

  /* --- Responsive --- */
  @media (max-width: 640px) {
    .digit {
      font-size: 5rem;
    }
    .not-found-title {
      font-size: 1.5rem;
    }
    .not-found-description {
      font-size: 1rem;
    }
    .not-found-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .btn {
      justify-content: center;
    }
  }
</style>
