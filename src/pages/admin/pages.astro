---
// ============================================
// /admin/pages — Administración de Páginas
// ============================================
// Vista de gestión y listado de páginas personalizadas.
// Usa AdminLayout como layout base.
// ============================================

import AdminLayout from "../../components/admin/AdminLayout.astro";
---

<AdminLayout>
  <div class="card">
    <div class="card-header pages-header">
      <span>Administración de Páginas</span>
      <a href="/admin/pages/editor" class="btn btn-primary btn-sm" id="btn-create-page">
        + Crear nueva página
      </a>
    </div>
    <p class="text-muted" style="margin-bottom: 1.5rem;">
      Crea, edita y gestiona las páginas de tu sitio web.
    </p>

    <!-- Listado de páginas -->
    <div id="pages-list-container" class="pages-table-wrap">
      <p class="text-muted">Cargando páginas...</p>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- Modal: Confirmar Eliminación -->
  <!-- ============================================ -->
  <div id="delete-modal" class="modal-overlay hidden" style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div class="card" style="width: 100%; max-width: 450px; background: var(--bg-card, #ffffff); border-radius: 8px; padding: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="margin: 0;">¿Eliminar página?</h3>
        <button id="btn-close-delete" type="button" style="background: none; border: none; font-size: 1.25rem; cursor: pointer;">&times;</button>
      </div>

      <p class="text-muted">
        Esta acción no se puede deshacer. ¿Seguro que deseas eliminar la página <strong id="delete-page-title"></strong>?
      </p>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
        <button type="button" id="btn-cancel-delete" class="btn btn-secondary">Cancelar</button>
        <button type="button" id="btn-confirm-delete" class="btn btn-danger">Sí, eliminar</button>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .pages-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .pages-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  /* En pantallas pequeñas la tabla usa scroll horizontal */
  .pages-table-wrap :global(table) {
    min-width: 540px;
  }
  @media (max-width: 640px) {
    .pages-header {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
    .pages-header :global(.btn) {
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  import { initPagesConfig } from "../../components/admin/PagesConfig";
  initPagesConfig();
</script>

